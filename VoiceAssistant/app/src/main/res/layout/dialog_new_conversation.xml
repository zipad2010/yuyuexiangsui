<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/AppTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/et_conv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="对话名称（可留空）"
            android:maxLength="60"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_conv_persona_pick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center"
        android:padding="14dp"
        android:text="点击选择人设（可选）"
        android:textColor="@color/accent"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="提示：只有已订阅的人设可用，可到投稿中心订阅"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

</LinearLayout>
